# The image copies only go.mod/go.sum, cmd/ and internal/ (see Dockerfile);
# everything listed here just keeps the rest of the tree out of the build
# context.

# Development
.git/
.github/
.kiro/
.vscode/
.secret/
.agent/
.claude/
.idea/

# Runtime state (certs, config, storage) — must never be baked into an image
.odac/

# Release CI scratch (release.yml installs semantic-release into the workspace
# before building the image from the same checkout)
node_modules/
.release-version

# Locally compiled binaries (image builds its own in the go-builder stage;
# a dev machine's copies may be the wrong arch/OS)
bin/

# Documentation
docs/
*.md

# Logs
*.log

# Build artifacts
dist/
build/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~
