#!/usr/bin/env node

let args = process.argv
if(process.argv[0].includes('node')) args = process.argv.slice(1)

if (args.includes('watchdog')) {
  const fs = require('fs')
  const path = require('path')
  const goWatchdog = path.join(__dirname, process.platform === 'win32' ? 'odac-watchdog.exe' : 'odac-watchdog')

  if (fs.existsSync(goWatchdog)) {
    // Go watchdog available: run it and mirror its exit code
    const {spawn} = require('child_process')
    const child = spawn(goWatchdog, [], {stdio: 'inherit'})
    child.on('close', code => process.exit(code ?? 1))
  } else {
    require('../watchdog/index.js')
  }
} else {
  require('../cli/index.js')
}
